# ==============================================================================
# StreamForge Environment Configuration — copy to .env and set real values
# Never commit .env
# ==============================================================================
# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=fleet-telemetry
KAFKA_CHANGELOG_TOPIC=streamforge.truck_state.changelog
KAFKA_CONSUMER_GROUP=streamforge-workers
KAFKA_PARTITIONS=32

# Fleet
FLEET_SIZE=50000

# Windowing — Watermark = max_event_time - MAX_LATENESS_MS (monotonic)
WINDOW_SIZE_MS=300000
MAX_LATENESS_MS=15000
WATERMARK_IDLE_TIMEOUT_MS=30000
LATE_EVENT_POLICY=side_output

# Workers / State — production=real RocksDB (Docker/Linux), demo/test=in-memory
STORAGE_MODE=demo
WORKERS=20
ROCKSDB_BASE_PATH=/tmp/streamforge_rocksdb
WORKER_ID=worker-01

# API / Metrics
API_HOST=0.0.0.0
API_PORT=8000
METRICS_PORT=9102
LOG_LEVEL=INFO

# Frontend — Vite
VITE_API_URL=http://localhost:8000

# Optional: Gemini (AI Studio)
GEMINI_API_KEY=""
APP_URL="http://localhost:3000"
